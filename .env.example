# Ejemplo de variables. La sección Backend va en backend/.env y la sección Frontend en
# frontend/.env.local. Ninguno de los dos archivos se sube al repositorio.
# En producción, los valores se pegan en Railway (backend) y Vercel (frontend): ver docs/despliegue.md.

# Backend (FastAPI) ---------------------------------------------------------
# Gemini recomendado en producción: Vertex AI + cuenta de servicio con el único rol
# Vertex AI User (roles/aiplatform.user). Crear cuenta y clave JSON en IAM:
# ver docs/despliegue.md, sección 4. Codificar el JSON completo como base64.
# Pegar el valor real SOLO en las variables privadas de Railway; nunca en este ejemplo.
# Descomentar solo con un valor válido: una variable presente pero vacía impide arrancar.
# GOOGLE_CREDENTIALS_B64=
# Sin GOOGLE_CREDENTIALS_B64 se conserva ADC local:
# gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Alternativa si una política de la organización impide crear llaves de cuenta de servicio:
# API key de AI Studio, GOOGLE_GENAI_USE_VERTEXAI=false y sin GOOGLE_CREDENTIALS_B64.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Llave secreta del árbitro (S...). Nunca sale del backend.
# Local: stellar keys secret cyc-arbiter
ARBITER_SECRET_KEY=

CONTRACT_ID=CAWAZODOFP67HETHN4NLYOECPCJACGLUTCLARVGLBZ7TJDLT4KLQRATQ
USDC_SAC_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Orígenes permitidos por CORS; admite varios separados por comas (sin barra final).
FRONTEND_ORIGIN=http://localhost:3000
STATE_FILE=backend/state.json

# Identidad verificable (SEP-10). Opcional: el flujo del dinero no la necesita.
# Llave nueva y sin fondos que firma los retos; NUNCA la del árbitro. Nunca se imprime.
SEP10_SIGNING_SECRET=
# Secreto para firmar las sesiones (HMAC). Mínimo 32 caracteres aleatorios.
SESSION_SECRET=

# Límite de peticiones a /tasks/draft, /tasks/draft/review y /evaluate. Vacío = sin límite (local).
# En la versión pública, por ejemplo 10 por IP y minuto y 500 al día para toda la app.
RATE_LIMIT_PER_MINUTE=
RATE_LIMIT_DAILY=

# Cuotas independientes de llamadas reales a Gemini. Si se omiten, usan RATE_LIMIT_DAILY.
# RATE_LIMIT_DAILY_BORRADOR=500
# RATE_LIMIT_DAILY_MOTOR=500
# Escrituras públicas por IP (sin cuota diaria); por defecto 30.
RATE_LIMIT_WRITES_PER_MINUTE=30
# Documentación de la API cerrada salvo habilitación explícita.
ENABLE_API_DOCS=false

# Opcionales de identidad (SEP-10), con valor por defecto:
# SEP10_HOME_DOMAIN=      # por defecto, el host del primer FRONTEND_ORIGIN
# SEP10_WEB_AUTH_DOMAIN=  # por defecto, RAILWAY_PUBLIC_DOMAIN o localhost:8000
# HORIZON_URL=https://horizon-testnet.stellar.org

# Frontend (Next.js) --------------------------------------------------------
NEXT_PUBLIC_POLLAR_API_KEY=
# pollar (por defecto) o freighter (respaldo: la extensión firma deposit y client_release)
NEXT_PUBLIC_WALLET=pollar
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_USDC_ASSET=USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
NEXT_PUBLIC_CONTRACT_ID=CAWAZODOFP67HETHN4NLYOECPCJACGLUTCLARVGLBZ7TJDLT4KLQRATQ
# Obligatoria en producción (URL del backend, sin barra final).
NEXT_PUBLIC_API_URL=http://localhost:8000
