# Backend (FastAPI) ---------------------------------------------------------
# Gemini recomendado en producción: Vertex AI + cuenta de servicio con el único rol
# Vertex AI User (roles/aiplatform.user). Crear cuenta y clave JSON en IAM:
# ver docs/despliegue.md, sección 4. Codificar el JSON completo como base64.
# Pegar el valor real SOLO en las variables privadas de Railway; nunca en este ejemplo.
# Descomentar solo con un valor válido: una variable presente pero vacía impide arrancar.
# GOOGLE_CREDENTIALS_B64=
# Sin GOOGLE_CREDENTIALS_B64 se conserva ADC local:
# gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Alternativa si una política de la organización impide crear llaves de cuenta de servicio:
# API key de AI Studio, GOOGLE_GENAI_USE_VERTEXAI=false y sin GOOGLE_CREDENTIALS_B64.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Llave secreta del árbitro (S...). Nunca sale del backend.
# Local: stellar keys secret cyc-arbiter
ARBITER_SECRET_KEY=

CONTRACT_ID=CAWAZODOFP67HETHN4NLYOECPCJACGLUTCLARVGLBZ7TJDLT4KLQRATQ
USDC_SAC_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

FRONTEND_ORIGIN=http://localhost:3000
STATE_FILE=backend/state.json

# Identidad verificable (SEP-10). Opcional: el flujo del dinero no la necesita.
# Llave nueva y sin fondos que firma los retos; NUNCA la del árbitro. Nunca se imprime.
SEP10_SIGNING_SECRET=
# Secreto para firmar las sesiones (HMAC). Genera uno largo y aleatorio.
SESSION_SECRET=

# Límite de peticiones a /tasks/draft, /tasks/draft/review y /evaluate. Vacío = sin límite (local).
# En la versión pública, por ejemplo 10 por IP y minuto y 500 al día para toda la app.
RATE_LIMIT_PER_MINUTE=
RATE_LIMIT_DAILY=
